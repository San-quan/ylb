# ===========================================
# Git忽略规则 - 私域引流宝
# ===========================================

# ===========================================
# 🔒 敏感文件 - 禁止提交
# ===========================================

# 环境变量配置文件（包含数据库密码等敏感信息）
.env
.env.local
.env.production
.env.*.local

# 密钥文件
*.pem
*.key
*.cert
ssl/

# ===========================================
# 📦 构建产物
# ===========================================

# 编译输出
/vendor/
/node_modules/
/build/
/dist/

# 压缩包（使用源码部署）
*.tar.gz
*.zip
!liuyinbao_v2.4.6_files.tar.gz

# ===========================================
# 📝 日志和临时文件
# ===========================================

# 日志文件
*.log
logs/
*.log.*

# 临时文件
*.tmp
*.temp
*.swp
*~
.DS_Store
Thumbs.db
Thumbs.db:encryptable

# IDE配置
.idea/
.vscode/
*.sublime-*
*.sublime-project

# ===========================================
# 📤 上传文件
# ===========================================

# 用户上传的文件
console/upload/*
!console/upload/.gitkeep

# 上传的临时文件
*.uploading

# ===========================================
# 🔧 系统文件
# ===========================================

# 备份文件
*.bak
*.backup
*_backup*

# 缓存文件
cache/
*.cache
.phpunit.cache/

# Composer依赖（如果不需要提交）
# composer.phar

# ===========================================
# ⚠️ 其他
# ===========================================

# 测试覆盖率报告
/coverage/
*.coverage

# 敏感信息文件
credentials.json
secrets.json
passwords.txt