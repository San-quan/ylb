# ===========================================
# 私域引流宝 - 环境变量配置文件
# ===========================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置值
# 3. 绝对不要提交 .env 文件到版本库！
# ===========================================

# ===========================================
# 📦 数据库配置
# ===========================================

# 数据库主机地址
# 说明: 数据库服务器的IP地址或域名
# 示例: localhost, 127.0.0.1, db.example.com
DB_HOST=localhost

# 数据库端口
# 说明: MySQL服务端口，默认为3306
# 范围: 1-65535
DB_PORT=3306

# 数据库名称
# 说明: 要连接的数据库名称
# 示例: llk5g_com, ylb_production
DB_NAME=llk5g_com

# 数据库用户名
# 说明: 连接数据库使用的用户名
# 示例: llk5g_com, root
DB_USER=llk5g_com

# 数据库密码
# ⚠️ 重要: 生产环境必须修改为强密码！
# 说明: 连接数据库的密码
# 建议: 使用至少16位的随机密码
DB_PASSWORD=8dwZwDkGMaWEdijK

# 数据表前缀
# 说明: 所有数据表的前缀，便于多项目共用数据库
# 示例: ylb_, 空字符串表示无前缀
DB_PREFIX=

# ===========================================
# 🖥️ 应用配置
# ===========================================

# 应用版本号
# 说明: 当前系统版本号，用于版本检测和升级判断
# 格式: X.Y.Z (如 2.4.6)
# 注意: 不要手动修改，由系统升级自动更新
APP_VERSION=2.4.6

# 调试模式
# 说明: 开启后显示详细错误信息，便于开发调试
# 值: true = 开启, false = 关闭
# ⚠️ 生产环境必须关闭！
APP_DEBUG=false

# 应用名称
# 说明: 显示在页面标题和系统信息中的名称
# 最大长度: 50个字符
APP_NAME=私域引流宝

# ===========================================
# 🔐 安全配置
# ===========================================

# 会话生命周期
# 说明: 用户登录状态的保持时间
# 单位: 秒
# 示例: 604800 = 7天, 2592000 = 30天, 31536000 = 365天
# 范围: 60 - 31536000 (1分钟 ~ 1年)
SESSION_LIFETIME=604800

# CSRF令牌保护
# 说明: 是否启用CSRF令牌验证，防止跨站请求伪造
# 值: true = 开启, false = 关闭
# 建议: 生产环境开启
CSRF_TOKEN=true

# API密钥
# ⚠️ 重要: 生产环境必须设置！
# 说明: 用于API接口认证的密钥，长度至少32位
# 生成方式: openssl rand -hex 32
# 示例: a1b2c3d4e5f6... (64位十六进制字符串)
API_SECRET_KEY=

# ===========================================
# 🌐 API配置
# ===========================================

# API频率限制
# 说明: 单个IP每分钟允许的最大请求次数
# 示例: 60 = 每分钟60次, 100 = 每分钟100次
# 范围: 1 - 10000
API_RATE_LIMIT=60

# API请求超时时间
# 说明: API请求的最大等待时间
# 单位: 秒
# 示例: 30 = 30秒, 60 = 60秒
# 范围: 1 - 300
API_TIMEOUT=30

# ===========================================
# 📧 通知配置
# ===========================================

# 通知邮箱
# 说明: 接收系统通知的邮箱地址
# 示例: admin@example.com, notify@company.com
# 格式: 有效的电子邮件地址
NOTIFICATION_EMAIL=

# WebHook通知地址
# 说明: 接收通知的WebHook URL，支持 Bark/Server酱 等
# 示例: https://api.day.app/your-token
# 格式: 有效的HTTP/HTTPS URL
NOTIFICATION_WEBHOOK=

# ===========================================
# ☁️ 对象存储配置（可选）
# ===========================================

# OSS服务地址
# 说明: 对象存储服务的_endpoint地址
# 示例: https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=

# OSS访问密钥ID
# 说明: 阿里云OSS的AccessKeyId
OSS_ACCESS_KEY=

# OSS访问密钥密码
# ⚠️ 重要: 生产环境必须保密！
# 说明: 阿里云OSS的AccessKeySecret
OSS_ACCESS_SECRET=

# OSS存储桶名称
# 说明: 用于存储文件的空间名称
OSS_BUCKET=

# ===========================================
# 📝 日志配置
# ===========================================

# 日志级别
# 说明: 日志记录详细程度
# 值: debug, info, warning, error, none
LOG_LEVEL=info

# 日志保留天数
# 说明: 日志文件保留的天数，超出后自动清理
# 示例: 30 = 保留30天
LOG_KEEP_DAYS=30

# ===========================================
# 🔧 其他配置
# ===========================================

# 时区设置
# 说明: 服务器时区，影响时间显示
# 示例: Asia/Shanghai, UTC, America/New_York
TIMEZONE=Asia/Shanghai

# 语言设置
# 说明: 系统界面语言
# 示例: zh_CN, en_US
LANG=zh_CN